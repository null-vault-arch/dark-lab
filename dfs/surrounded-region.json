{
  "title":"surrounded-region",
  "code":"
  #include<iostream>
#include<vector>
using namespace std;

void dfs(vector<vector<char>>& board,int i,int j){
    int n=board.size();
    int m=board[0].size();

    if(i<0||i>=n||j<0||j>=m||board[i][j]!='O')
        return;

    board[i][j]='T';

    dfs(board,i+1,j);
    dfs(board,i-1,j);
    dfs(board,i,j+1);
    dfs(board,i,j-1);
}

int main(){
    int n,m;
    cin>>n>>m;

    vector<vector<char>> board(n,vector<char>(m));

    for(int i=0;i<n;i++){
        for(int j=0;j<m;j++){
            cin>>board[i][j];
        }
    }

    for(int i=0;i<n;i++){
        dfs(board,i,0);
        dfs(board,i,m-1);
    }

    for(int j=0;j<m;j++){
        dfs(board,0,j);
        dfs(board,n-1,j);
    }

    for(int i=0;i<n;i++){
        for(int j=0;j<m;j++){
            if(board[i][j]=='O')
                board[i][j]='X';
            else if(board[i][j]=='T')
                board[i][j]='O';
        }
    }

    for(int i=0;i<n;i++){
        for(int j=0;j<m;j++){
            cout<<board[i][j]<<" ";
        }
        cout<<endl;
    }

    return 0;
}
  "
}
