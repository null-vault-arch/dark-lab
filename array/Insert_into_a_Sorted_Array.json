{
  "title":"Insert into a Sorted Array",
  "code":"#include <iostream>
using namespace std;

int main() {
    int n, a[2201], x;
    cin >> n;

    for (int i = 0; i < n; i++)
        cin >> a[i];

    cin >> x;

    int i = n - 1;
    while (i >= 0 && a[i] > x) {
        a[i + 1] = a[i];
        i--;
    }

    a[i + 1] = x;

    for (int j = 0; j <= n; j++)
        cout << a[j] << " ";

    return 0;
}"
}
